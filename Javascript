// =====================================
// 8. MEMBER REGISTRATION & VALIDATION
// =====================================

registrationForm.addEventListener("submit", function (event) {
    event.preventDefault();

    const name = studentName.value.trim();
    const id = studentId.value.trim();
    const email = studentEmail.value.trim().toLowerCase();
    const clubId = Number(joinClub.value);

    if (name.length < 2) {
        showMessage(
            registrationMessage,
            "Please enter a valid full name.",
            "error"
        );
        return;
    }

    if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) {
        showMessage(
            registrationMessage,
            "Enter a valid Student ID using letters, numbers, _ or -.",
            "error"
        );
        return;
    }

    if (!studentEmail.validity.valid || !email) {
        showMessage(
            registrationMessage,
            "Please enter a valid email address.",
            "error"
        );
        return;
    }

    const club = getClub(clubId);

    if (!club) {
        showMessage(
            registrationMessage,
            "Please select a valid club.",
            "error"
        );
        return;
    }

    const normalizedId = id.toLowerCase();

    let existingMember = members.find(member =>
        member.studentId.toLowerCase() === normalizedId
    );

    if (existingMember) {
        if (existingMember.email.toLowerCase() !== email) {
            showMessage(
                registrationMessage,
                "Student ID is already registered with another email.",
                "error"
            );
            return;
        }

        if (existingMember.clubs.includes(clubId)) {
            showMessage(
                registrationMessage,
                "You have already joined this club!",
                "error"
            );
            return;
        }

        const oldClubs = [...existingMember.clubs];

        existingMember.clubs.push(clubId);
        existingMember.name = name;

        if (!saveData("cc_members", members)) {
            existingMember.clubs = oldClubs;
            return;
        }
    } else {
        const newMember = {
            name: name,
            studentId: id,
            email: email,
            clubs: [clubId]
        };

        members.push(newMember);

        if (!saveData("cc_members", members)) {
            members.pop();
            return;
        }
    }

    currentStudentId = id;
    localStorage.setItem("cc_current_student", id);

    showMessage(
        registrationMessage,
        "Registration successful! You joined " + club.name + ".",
        "ok"
    );

    registrationForm.reset();

    refreshAll();
});

// =====================================
// 9. JOIN AND LEAVE CLUB
// =====================================

function joinClubAction(clubId) {
    const club = getClub(clubId);

    if (!club) return;

    if (!getCurrentMember()) {
        joinClub.value = String(clubId);

        document.getElementById("registrationSection")
            .scrollIntoView({ behavior: "smooth" });

        showMessage(
            registrationMessage,
            "Enter your details below to join " + club.name + ".",
            "ok"
        );

        closeModal();
        return;
    }

    const member = getCurrentMember();

    if (member.clubs.includes(clubId)) {
        alert("You have already joined this club.");
        return;
    }

    member.clubs.push(clubId);

    if (!saveData("cc_members", members)) {
        member.clubs.pop();
        return;
    }

    alert("You have successfully joined " + club.name + "!");
    closeModal();
    refreshAll();
}

function leaveClubAction(clubId) {
    const club = getClub(clubId);
    const member = getCurrentMember();

    if (!club || !member) {
        alert("Please register before leaving a club.");
        return;
    }

    if (!member.clubs.includes(clubId)) {
        alert("You have not joined this club.");
        return;
    }

    const confirmed = confirm(
        "Are you sure you want to leave " + club.name + "?"
    );

    if (!confirmed) return;

    const oldClubs = [...member.clubs];

    member.clubs = member.clubs.filter(id => id !== clubId);

    if (!saveData("cc_members", members)) {
        member.clubs = oldClubs;
        return;
    }

    alert("You have left " + club.name + ".");
    closeModal();
    refreshAll();
}

// =====================================
// 10. DISPLAY CLUB MEMBERS
// =====================================

function displayMembers(clubId) {
    const club = getClub(clubId);

    if (!club) {
        membersContainer.innerHTML = "";
        return;
    }

    const clubMembers = members.filter(member =>
        Array.isArray(member.clubs) &&
        member.clubs.includes(Number(clubId))
    );

    if (clubMembers.length === 0) {
        membersContainer.innerHTML = `
            <p class="empty-message">
                No members have registered for
                ${escapeHTML(club.name)} yet.
            </p>
        `;
        return;
    }

    membersContainer.innerHTML = `
        <h3 style="margin-bottom: 12px;">
            ${escapeHTML(club.name)} — ${clubMembers.length} Member(s)
        </h3>

        <div class="member-table-wrap">
            <table class="member-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Student Name</th>
                        <th>Student ID</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>
                    ${clubMembers.map((member, index) => `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${escapeHTML(member.name)}</td>
                            <td>${escapeHTML(member.studentId)}</td>
                            <td>${escapeHTML(member.email)}</td>
                        </tr>
                    `).join("")}
                </tbody>
            </table>
        </div>
    `;
}

// =====================================
// 11. ADD EVENT ANNOUNCEMENTS
// =====================================

eventForm.addEventListener("submit", function (event) {
    event.preventDefault();

    const title = eventTitle.value.trim();
    const clubId = Number(eventClub.value);
    const date = eventDate.value;
    const description = eventDescription.value.trim();

    const club = getClub(clubId);

    if (!title || !description || !club || !date) {
        showMessage(
            eventMessage,
            "Please fill in all event details.",
            "error"
        );
        return;
    }

    const selectedDate = new Date(date + "T00:00:00");

    if (Number.isNaN(selectedDate.getTime())) {
        showMessage(
            eventMessage,
            "Please enter a valid event date.",
            "error"
        );
        return;
    }

    const newEvent = {
        id: Date.now(),
        title: title,
        clubId: clubId,
        date: date,
        description: description
    };

    events.push(newEvent);

    if (!saveData("cc_events", events)) {
        events.pop();
        return;
    }

    showMessage(
        eventMessage,
        "Event announcement added successfully!",
        "ok"
    );

    eventForm.reset();
    refreshAll();
});

// =====================================
// 12. DISPLAY EVENT ANNOUNCEMENTS
// =====================================

function displayEvents() {
    const sortedEvents = [...events].sort((a, b) =>
        a.date.localeCompare(b.date)
    );

    if (sortedEvents.length === 0) {
        eventContainer.innerHTML = `
            <p class="empty-message">
                No event announcements available yet.
            </p>
        `;
        return;
    }

    eventContainer.innerHTML = sortedEvents.map(item => {
        const club = getClub(item.clubId);

        return `
            <article class="event-card">
                <span class="event-date">
                    📅 ${escapeHTML(formatDate(item.date))}
                </span>

                <h3>${escapeHTML(item.title)}</h3>

                <p>
                    🏛️ ${escapeHTML(club ? club.name : "College Event")}
                </p>

                <p>${escapeHTML(item.description)}</p>
            </article>
        `;
    }).join("");
}

// =====================================
// 13. HANDLE CLUB CARD BUTTONS
// =====================================

document.addEventListener("click", function (event) {
    const button = event.target.closest("button[data-action]");

    if (!button) return;

    const action = button.dataset.action;
    const id = Number(button.dataset.id);

 if (!getClub(id)) return;

    if (action === "info") {
        showClubInfo(id);
    }

    if (action === "join") {
        joinClubAction(id);
    }

    if (action === "leave") {
        leaveClubAction(id);
    }

    if (action === "members") {
        memberClubFilter.value = String(id);
        displayMembers(id);

        document.getElementById("membersContainer")
            .scrollIntoView({ behavior: "smooth", block: "center" });
    }
});

// =====================================
// 14. SEARCH AND FILTER
// =====================================

searchInput.addEventListener("input", displayClubs);
categoryFilter.addEventListener("change", displayClubs);

memberClubFilter.addEventListener("change", function () {
    if (memberClubFilter.value) {
        displayMembers(Number(memberClubFilter.value));
    } else {
        membersContainer.innerHTML = "";
    }
});
