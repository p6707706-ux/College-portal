
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #3157d5;
    --primary-dark: #2443ad;
    --background: #f4f7fc;
    --text: #202b42;
    --muted: #68758b;
    --border: #e0e6f0;
    --white: #ffffff;
    --green: #16875d;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

.header {
    background: var(--white);
    padding: 18px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 1px solid var(--border);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo {
    background: #e8edff;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    font-size: 25px;
}

.brand h1 {
    font-size: 22px;
    color: var(--primary);
}

.brand p,
.section-heading p {
    font-size: 13px;
    color: var(--muted);
}

.header-label {
    background: #e9f7ef;
    color: var(--green);
    border-radius: 30px;
    padding: 8px 15px;
    font-size: 13px;
    font-weight: bold;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 28px auto;
}

.welcome {
    background: linear-gradient(120deg, #3157d5, #7459d9);
    color: white;
    padding: 35px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 10px 25px #3157d522;
}

.eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 8px;
    opacity: 0.85;
}

.welcome h2 {
    font-size: clamp(25px, 4vw, 36px);
    margin-bottom: 8px;
}

.welcome p:last-child {
    font-size: 14px;
}

.welcome-icon {
    font-size: 65px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin: 25px 0 35px;
}

.stat-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-card > span {
    background: #edf0ff;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-size: 23px;
}

.stat-card p {
    font-size: 13px;
    color: var(--muted);
}

.stat-card h3 {
    font-size: 25px;
}

.section {
    margin-bottom: 35px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.section-heading h2 {
    font-size: 23px;
}

.filters {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 14px;
    margin-bottom: 22px;
}

input,
select {
    width: 100%;
    padding: 12px 13px;
    border: 1px solid #d8dfeb;
    border-radius: 9px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: white;
    outline: none;
}

input:focus,
select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px #3157d51a;
}

.club-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.club-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 21px;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
}

.club-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px #202b4210;
}

.club-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}

.club-icon {
    width: 55px;
    height: 55px;
    border-radius: 14px;
    background: #edf0ff;
    display: grid;
    place-items: center;
    font-size: 28px;
}

.category {
    font-size: 11px;
    font-weight: bold;
    color: var(--primary);
    background: #edf0ff;
    padding: 5px 10px;
    border-radius: 20px;
}

.club-card h3 {
    font-size: 19px;
    margin-bottom: 7px;
}

.club-card > p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 14px;
    flex-grow: 1;
}

.club-meta {
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 15px;
}

.club-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
}

.btn {
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    font: inherit;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

.btn:hover {
    filter: brightness(0.95);
}

.btn:focus-visible,
.close-btn:focus-visible {
    outline: 3px solid #91a8ff;
    outline-offset: 2px;
}

.primary {
    color: white;
    background: var(--primary);
}

.primary:hover {
    background: var(--primary-dark);
}

.secondary {
    color: var(--text);
    background: #edf0f6;
}

.success {
    color: white;
    background: var(--green);
}

.danger {
    color: #b42332;
    background: #ffeaed;
}

.small-btn {
    padding: 8px 10px;
    font-size: 12px;
}

.panel {
    background: white;
    padding: 26px;
    border-radius: 17px;
    border: 1px solid var(--border);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group label {
    font-size: 13px;
    font-weight: bold;
}

.form-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.message {
    margin-top: 12px;
    font-size: 13px;
    font-weight: bold;
}

.message:empty {
    display: none;
}

.message.error {
    color: #b42332;
}

.message.ok {
    color: var(--green);
}

.event-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-top: 22px;
}

.event-card {
    padding: 18px;
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: 12px;
    background: #fbfcff;
}

.event-card h3 {
    font-size: 17px;
    margin: 8px 0;
}

.event-card p {
    color: var(--muted);
    font-size: 13px;
    overflow-wrap: anywhere;
}

.event-date {
    color: var(--primary);
    font-weight: bold;
    font-size: 12px;
}

.member-filter {
    max-width: 450px;
    margin-bottom: 20px;
}

.member-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.member-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    min-width: 500px;
}

.member-table th,
.member-table td {
    text-align: left;
    padding: 13px;
    border-bottom: 1px solid var(--border);
}

.member-table th {
    background: #f3f5fc;
}

.empty-message {
    text-align: center;
    color: var(--muted);
    padding: 25px;
    background: white;
    border-radius: 12px;
}

.empty-message[hidden],
.modal[hidden] {
    display: none;
}

footer {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    padding: 25px 10px;
}

.modal {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: #11182799;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.modal-content {
    width: 100%;
    max-width: 520px;
    max-height: 85vh;
    overflow-y: auto;
    background: white;
    padding: 30px;
    border-radius: 18px;
    position: relative;
}

.close-btn {
    position: absolute;
    right: 17px;
    top: 10px;
    border: none;
    background: none;
    font-size: 30px;
    cursor: pointer;
    color: var(--muted);
}

.modal-content h2 {
    padding-right: 25px;
    margin-bottom: 12px;
}

.modal-content p {
    color: var(--muted);
    margin: 10px 0;
    font-size: 14px;
    overflow-wrap: anywhere;
}

@media (max-width: 900px) {
    .club-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .header {
        padding: 14px 5%;
    }

    .brand h1 {
        font-size: 18px;
    }

    .brand p {
        font-size: 11px;
    }

    .header-label {
        font-size: 10px;
        padding: 6px 9px;
    }

    .container {
        width: 92%;
        margin-top: 18px;
    }

    .welcome {
        padding: 24px 20px;
    }

    .welcome-icon {
        font-size: 40px;
    }

    .stats {
        gap: 9px;
    }

    .stat-card {
        padding: 12px 8px;
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
    }

    .stat-card > span {
        width: 38px;
        height: 38px;
        font-size: 19px;
    }

    .stat-card p {
        font-size: 11px;
    }

    .stat-card h3 {
        font-size: 21px;
    }

    .club-grid,
    .event-grid,
    .form-grid {
        grid-template-columns: 1fr;
    }

    .filters {
        grid-template-columns: 1fr;
    }

    .section-heading h2 {
        font-size: 20px;
    }

    .panel {
        padding: 19px;
    }

    .form-actions {
        grid-column: auto;
    }

    .modal-content {
        padding: 25px 20px;
    }
}
